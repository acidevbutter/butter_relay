DEBUG=true
LOG_LEVEL=INFO

# Hostnames resolve on the Docker network (scripts/dev-up.sh / compose).
# Settings assembles postgresql+asyncpg:// from these parts. DATABASE_URL is ignored.
DATABASE_HOST=shared-postgres
DATABASE_PORT=5432
DATABASE_USER=relay
DATABASE_PASSWORD=relay
DATABASE_NAME=relay

# Celery broker/result backend. devbutter_backend and selolibertaria_backend
# must point at this same Redis instance to publish onto RELAY_QUEUE_NAME.
REDIS_URL=redis://redis:6379/0
RELAY_QUEUE_NAME=relay-shared

BREVO_API_KEY=

# butter_blob — same nfse namespace as the originator. bbk_ preferred.
BUTTER_BLOB_BASE_URL=http://blob-api:8000
# Must match butter_blob SERVICE_API_KEY (legacy X-Service-Api-Key).
BUTTER_BLOB_API_KEY=change-me-in-production
BUTTER_BLOB_NAMESPACE=nfse
BUTTER_BLOB_TIMEOUT_SECONDS=15

# Em staging/preprod, obrigatório para liberar entrega externa. Exemplo:
# devbutter.tech. Production deixa vazio.
ALLOWED_RECIPIENT_DOMAINS=

SESSION_SECRET=change-me-in-production
SESSION_COOKIE_NAME=butter_relay_session
