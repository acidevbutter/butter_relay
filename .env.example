DEBUG=true
LOG_LEVEL=INFO

# Hostnames resolve on the Docker network (scripts/dev-up.sh / compose).
# Settings assembles postgresql+asyncpg:// from these parts. DATABASE_URL is ignored.
DATABASE_HOST=shared-postgres
DATABASE_PORT=5432
DATABASE_USER=relay
DATABASE_PASSWORD=relay
DATABASE_NAME=relay

# Celery broker/result backend. devbutter_backend and selolibertaria_backend
# must point at this same Redis instance to publish onto RELAY_QUEUE_NAME.
REDIS_URL=redis://redis:6379/0
RELAY_QUEUE_NAME=relay-shared
# Largest task payload (JSON bytes) the worker renders; bigger ones are rejected.
RELAY_MAX_PAYLOAD_BYTES=65536
# Requests per minute per API key (a project can override it); 0 disables.
RELAY_DEFAULT_RATE_PER_MINUTE=120
# Days to keep payloads of finished messages / recipients of rejected tasks (LGPD).
MESSAGE_BODY_RETENTION_DAYS=30
# The legacy Celery send_task(project_id, template_key, ...) trusts the producer's
# project_id (H-02). Set false once every producer uses POST /api/v1/messages/send.
ALLOW_LEGACY_SEND_TASK=true
# Comma-separated hosts that may serve /admin and the admin/service API. Empty = any host.
# With it set, the public host only answers /health and the client API (messages,
# email-types, templates). Example: ADMIN_ALLOWED_HOSTS=admin.relay.devbutter.tech
ADMIN_ALLOWED_HOSTS=
# Fernet keys (comma-separated, newest first) encrypting per-project delivery secrets.
# Mandatory outside development. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RELAY_SECRETS_KEYS=

# Brevo is the default delivery channel of every project (any environment).
# Required outside development; empty locally = Brevo sends fail with 401.
BREVO_API_KEY=

# Deployment defaults for projects whose delivery channel is "smtp" (mailpit in
# the local compose). A project can override host/port in the admin.
SMTP_HOST=mailpit
SMTP_PORT=1025

# butter_blob — same nfse namespace as the originator. bbk_ preferred.
BUTTER_BLOB_BASE_URL=http://blob-api:8000
# Must match butter_blob SERVICE_API_KEY (legacy X-Service-Api-Key).
BUTTER_BLOB_API_KEY=change-me-in-production
BUTTER_BLOB_NAMESPACE=nfse
BUTTER_BLOB_TIMEOUT_SECONDS=15

# Em staging/preprod, obrigatório para liberar entrega externa. Exemplo:
# devbutter.tech. Production deixa vazio.
ALLOWED_RECIPIENT_DOMAINS=

SESSION_SECRET=change-me-in-production
SESSION_COOKIE_NAME=butter_relay_session
