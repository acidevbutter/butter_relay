# `docker build -f docker/Dockerfile.api.hostinger .` — excludes local secrets and tests.
.git
.env
.env.*
certs/
*.key
*.pem
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
tests/
docs/
# Only the operational scripts (seed, purge) and templates ship in the image.
scripts/*
!scripts/__init__.py
!scripts/seed_*.py
!scripts/purge_*.py
!scripts/templates/
README.md
CHANGELOG.md
RELEASE_NOTES.md
