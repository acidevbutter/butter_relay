# Only for `docker build -f docker/Dockerfile.dokploy .` (BuildKit reads <Dockerfile>.dockerignore
# from the Dockerfile's own directory). Keeps secrets, tests and docs out of the
# Dokploy build context; config is injected as env vars at deploy time.
.git
.github
.env
.env.*
!.env.example
certs/
*.key
*.pem
*.crt
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
tests/
docs/
# Only the operational scripts (seed, purge) and templates ship in the image.
scripts/*
!scripts/__init__.py
!scripts/seed_*.py
!scripts/purge_*.py
!scripts/templates/
README.md
CHANGELOG.md
RELEASE_NOTES.md
CLAUDE.md
AGENTS.md
docker-compose*.yml
